{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitScope(deps)"
  ],
  "timezone": "UTC",
  "schedule": ["before 6am"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on Monday"]
  },
  "nix": {
    "enabled": true,
    "managerFilePatterns": ["flake\\.lock$", "flake\\.nix$"]
  },
  "cargo": {
    "enabled": true
  },
  "github-actions": {
    "enabled": true,
    "digest": {
      "enabled": false
    }
  },
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "addLabels": ["github-actions"]
    },
    {
      "description": "Group Cargo (Rust) dependency updates",
      "matchManagers": ["cargo"],
      "groupName": "cargo dependencies",
      "addLabels": ["rust"]
    },
    {
      "description": "Group Nix flake input updates",
      "matchManagers": ["nix"],
      "groupName": "nix flake inputs",
      "addLabels": ["nix"]
    },
    {
      "description": "Pin Determinate Systems actions to major version",
      "pinDigests": false,
      "matchPackageNames": [
        "/^DeterminateSystems//"
      ]
    }
  ]
}
